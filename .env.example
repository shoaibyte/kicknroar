# Server
PORT=8000
ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8000

# Database (use postgres://kicknroar:kicknroar123@localhost:5432/kicknroar for docker-compose)
DATABASE_URL=postgres://user:password@localhost:5432/kicknroar?sslmode=disable

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h

# AWS S3
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=ap-south-1
AWS_S3_BUCKET=kicknroar-production

# Google Maps (backend; also set VITE_* for frontend if using maps in dev)
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Rate limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=100
AUTH_RATE_LIMIT_REQUESTS_PER_MINUTE=5
UPLOAD_RATE_LIMIT_REQUESTS_PER_MINUTE=10

# Frontend (optional; only for local dev or when API is on a different host)
# VITE_API_URL is optional when app and API are same origin (monolith / Render)
# VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
